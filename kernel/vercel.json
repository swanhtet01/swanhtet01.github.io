{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": { "maxDuration": 30 },
    "api/stripe-webhook.mjs": { "maxDuration": 15 },
    "api/kbzpay-notify.mjs": { "maxDuration": 10 },
    "api/wavepay-notify.mjs": { "maxDuration": 10 },
    "api/status.mjs": { "maxDuration": 10 },
    "api/operator.mjs": { "maxDuration": 45 },
    "api/brief.mjs": { "maxDuration": 45 },
    "api/crew.mjs": { "maxDuration": 45 },
    "api/agent-company-auth.mjs": { "maxDuration": 15 },
    "api/agent-company.mjs": { "maxDuration": 60 },
    "api/workcell-plan.mjs": { "maxDuration": 10 },
    "api/workcells.mjs": { "maxDuration": 45 },
    "api/owner-evidence.mjs": { "maxDuration": 15 },
    "api/approvals.mjs": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/brief", "schedule": "30 1 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; frame-ancestors 'none'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook" },
    { "src": "/api/kbzpay-notify", "dest": "/api/kbzpay-notify" },
    { "src": "/api/wavepay-notify", "dest": "/api/wavepay-notify" },
    { "src": "/api/status", "dest": "/api/status" },
    { "src": "/api/operator", "dest": "/api/operator" },
    { "src": "/api/brief", "dest": "/api/brief" },
    { "src": "/api/crew", "dest": "/api/crew" },
    { "src": "/api/agent-company-auth", "dest": "/api/agent-company-auth" },
    { "src": "/api/agent-company", "dest": "/api/agent-company" },
    { "src": "/api/workcell-plan", "dest": "/api/workcell-plan" },
    { "src": "/api/workcells", "dest": "/api/workcells" },
    { "src": "/api/owner-evidence", "dest": "/api/owner-evidence" },
    { "src": "/api/approvals", "dest": "/api/approvals" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/status", "dest": "/status.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
