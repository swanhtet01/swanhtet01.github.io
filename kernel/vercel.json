{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": { "maxDuration": 30 },
    "api/stripe-webhook.mjs": { "maxDuration": 15 },
    "api/kbzpay-notify.mjs": { "maxDuration": 10 },
    "api/wavepay-notify.mjs": { "maxDuration": 10 },
    "api/status.mjs": { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook" },
    { "src": "/api/kbzpay-notify", "dest": "/api/kbzpay-notify" },
    { "src": "/api/wavepay-notify", "dest": "/api/wavepay-notify" },
    { "src": "/api/status", "dest": "/api/status" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
