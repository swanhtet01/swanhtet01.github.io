{
  "name": "supermega-console",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "brand:verify": "node scripts/verify-brand.mjs",
    "function:footprint": "node scripts/verify-function-footprint.mjs",
    "connector:resilience": "node ../tools/test_connector_resilience.mjs",
    "crew:resilience": "node ../tools/test_crew_resilience.mjs",
    "agent-company:operate": "node scripts/operate-agent-company.mjs",
    "workcell:provision": "node scripts/provision-workcell-client.mjs",
    "workcell:activate": "node scripts/activate-workcell-client.mjs",
    "verify": "npm test && npm run brand:verify && npm run function:footprint && npm run connector:resilience && npm run crew:resilience",
    "deploy:prod": "npm run verify && npx vercel deploy --prod -y"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^16.5.0"
  }
}
