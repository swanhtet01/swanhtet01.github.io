# eslint-plugin-jsx-a11y@6.10.2 (latest as of 2026-08) declares a peerDependencies
# range of eslint ^3..^9 and has not yet published support for eslint 10, which
# this project runs. The plugin works fine against eslint 10's flat-config API;
# only the declared peer range is stale. Without this, `npm install`/`npm ci`
# fail with ERESOLVE. Remove this file once jsx-a11y publishes an eslint 10 peer
# range.
legacy-peer-deps=true
