{
  "resource_id": "supermega-core-agent-workspace-v2",
  "tenant_key": "default",
  "company": {
    "name": "SuperMega",
    "public_label": "supermega.dev",
    "domain": "app.supermega.dev",
    "sector": "AI-native operating software",
    "customer_products": ["Shop", "Plant", "Website", "Ecommerce"]
  },
  "dialectic": {
    "thesis": "Use a small reusable specialist registry to operate the company with evidence.",
    "antithesis": "A large always-on roster creates cost, clutter, duplicated ownership, and unsafe autonomy.",
    "synthesis": "Keep four accountable teams, scale execution from zero only for queued work, and gate every consequential action."
  },
  "runtime_policy": {
    "contract": "supermega.agent-workforce-policy.v1",
    "execution_model": "ephemeral_demand_driven",
    "registered_specialists_consume_compute": false,
    "idle_active_execution_target": 0,
    "max_running": 4,
    "max_queued": 24,
    "max_daily_runs": 64,
    "max_daily_work_units": 96,
    "max_batch_jobs": 5,
    "max_registered_specialists": 256,
    "in_flight_per_job": 1,
    "budget_grant_secret_minimum_utf8_bytes": 32,
    "human_gates": ["external_send", "payment", "access_change", "customer_data_export", "publish", "merge", "deploy", "domain_change", "production_write", "equipment_control"]
  },
  "workspaces": [
    {
      "id": "product-hq",
      "name": "Product",
      "route": "/work/?team=product&view=work",
      "mission": "Turn customer evidence into one prioritized outcome and measurable acceptance contract.",
      "owner_roles": ["director", "architect"]
    },
    {
      "id": "engineering-hq",
      "name": "Engineering",
      "route": "/work/?team=engineering&view=work",
      "mission": "Implement, secure, verify, and release bounded changes with rollback evidence.",
      "owner_roles": ["platform_admin", "agent_ops"]
    },
    {
      "id": "growth-hq",
      "name": "Growth",
      "route": "/work/?team=growth&view=work",
      "mission": "Prepare truthful positioning, onboarding, qualification, and owner-approved communication.",
      "owner_roles": ["tenant_admin", "director"]
    },
    {
      "id": "finance-risk-hq",
      "name": "Finance / Risk",
      "route": "/work/?team=finance&view=work",
      "mission": "Control spend, privacy, access, security exceptions, and approval evidence.",
      "owner_roles": ["platform_admin", "tenant_admin"]
    }
  ],
  "role_profiles": [
    {
      "id": "platform_admin",
      "name": "Platform Admin",
      "home": "/work/?team=engineering&view=review",
      "mission": "Own runtime, access, security, and release posture.",
      "capabilities": ["platform_admin.view", "tenant_admin.view", "security_admin.view"],
      "tool_profile": "engineering-safe-stack"
    },
    {
      "id": "tenant_admin",
      "name": "Workspace Owner",
      "home": "/settings/",
      "mission": "Own one workspace, its users, data boundary, and activation decision.",
      "capabilities": ["tenant_admin.view", "connector_admin.view", "knowledge_admin.view"],
      "tool_profile": "workspace-safe-stack"
    },
    {
      "id": "architect",
      "name": "Product Architect",
      "home": "/work/?team=product&view=work",
      "mission": "Map real workflows into the four products and reusable client templates.",
      "capabilities": ["architect.view", "agent_ops.view", "director.view"],
      "tool_profile": "product-safe-stack"
    },
    {
      "id": "agent_ops",
      "name": "Agent Operations",
      "home": "/work/?team=engineering&view=agents",
      "mission": "Keep queued execution bounded, useful, attributable, and scaled to zero when idle.",
      "capabilities": ["agent_ops.view", "actions.view"],
      "tool_profile": "agent-ops-safe-stack"
    },
    {
      "id": "director",
      "name": "Director",
      "home": "/work/?team=product&view=review",
      "mission": "Review outcomes, risks, evidence, and the next company decision.",
      "capabilities": ["director.view", "actions.view", "operations.view"],
      "tool_profile": "product-safe-stack"
    },
    {
      "id": "knowledge_admin",
      "name": "Knowledge Steward",
      "home": "/work/?team=product&view=review",
      "mission": "Keep evidence, provenance, and reusable context trustworthy.",
      "capabilities": ["knowledge_admin.view", "security_admin.view"],
      "tool_profile": "workspace-safe-stack"
    }
  ],
  "tool_profiles": [
    {
      "id": "product-safe-stack",
      "name": "Product evidence stack",
      "tools": ["approved source read", "local analysis", "draft", "evaluation"],
      "forbidden": ["external send", "customer claim without evidence", "production write"]
    },
    {
      "id": "engineering-safe-stack",
      "name": "Engineering verification stack",
      "tools": ["scoped repository read", "bounded local edit", "tests", "security scan"],
      "forbidden": ["unapproved push", "merge", "deploy", "credential disclosure"]
    },
    {
      "id": "workspace-safe-stack",
      "name": "Workspace administration stack",
      "tools": ["tenant-scoped read", "approval preparation", "audit review"],
      "forbidden": ["access change", "data export", "connector write", "payment"]
    },
    {
      "id": "agent-ops-safe-stack",
      "name": "Demand-driven agent stack",
      "tools": ["queue read", "capacity plan", "signed budget grant", "trace review"],
      "forbidden": ["unbounded run", "duplicate in-flight job", "self-approval", "silent side effect"]
    }
  ],
  "knowledge_resources": [
    {"id": "hq-now", "name": "HQ now", "reference": "repository://hq/NOW.md", "authority": "current operating state"},
    {"id": "hq-board", "name": "Work board", "reference": "repository://hq/WORKBOARD.md", "authority": "assignment and evidence"},
    {"id": "portfolio", "name": "Portfolio", "reference": "repository://hq/portfolio.json", "authority": "four customer products"},
    {"id": "site-contract", "name": "Site manifest", "reference": "repository://site-manifest.json", "authority": "public routes and brand"}
  ],
  "trust_boundaries": [
    {
      "id": "workspace-scope",
      "name": "Workspace isolation",
      "rule": "Every data read and write is bound to authenticated workspace membership and least privilege.",
      "surfaces": ["managed API", "database RLS", "connectors"]
    },
    {
      "id": "private-storage",
      "name": "Private object storage",
      "rule": "Anonymous and broad authenticated bucket listing are denied; object access is authorized and short lived.",
      "surfaces": ["Supabase Storage", "S3-compatible storage", "client uploads"]
    },
    {
      "id": "autonomy-gate",
      "name": "Consequential action gate",
      "rule": "Agents prepare and verify; a named human authorizes consequential external or production actions.",
      "surfaces": ["/work/?view=agents", "managed queue", "approval ledger"]
    },
    {
      "id": "budget-gate",
      "name": "Execution budget",
      "rule": "A short-lived signed grant, one lease, idempotency, and remaining workspace capacity are required before execution.",
      "surfaces": ["capacity planner", "agent run queue", "budget reservation ledger"]
    },
    {
      "id": "release-observability",
      "name": "Release and observability",
      "rule": "A release retains immutable identity, rollback evidence, structured logs, and a bounded post-deploy error review.",
      "surfaces": ["Vercel release", "runtime logs", "release record"]
    }
  ],
  "ai_teams": [
    {
      "id": "product-team",
      "name": "Product Team",
      "workspace": "product-hq",
      "mission": "Own customer evidence, portfolio fit, acceptance, and measured learning.",
      "reads": ["approved research", "pilot evidence", "product metrics"],
      "writes": ["problem briefs", "acceptance proposals", "priority proposals"],
      "approval_gate": "Founder or product owner decision"
    },
    {
      "id": "engineering-team",
      "name": "Engineering Team",
      "workspace": "engineering-hq",
      "mission": "Own implementation, independent verification, security, incidents, and releases.",
      "reads": ["scoped code", "tests", "runtime evidence"],
      "writes": ["bounded local changes", "test evidence", "release candidates"],
      "approval_gate": "Independent review plus owner release decision"
    },
    {
      "id": "growth-team",
      "name": "Growth Team",
      "workspace": "growth-hq",
      "mission": "Own truthful positioning, onboarding, qualification, and draft communication.",
      "reads": ["approved claims", "pilot evidence", "lead context"],
      "writes": ["campaign drafts", "onboarding drafts", "follow-up proposals"],
      "approval_gate": "Founder approval before external send"
    },
    {
      "id": "finance-risk-team",
      "name": "Finance / Risk Team",
      "workspace": "finance-risk-hq",
      "mission": "Own spend, access, privacy, security exceptions, and approval quality.",
      "reads": ["budget evidence", "access evidence", "audit events"],
      "writes": ["risk findings", "approval proposals", "incident recommendations"],
      "approval_gate": "Named accountable human"
    }
  ],
  "execution_loops": [
    {
      "id": "product-loop",
      "name": "Product learning loop",
      "trigger": "Verified customer signal",
      "outputs": ["one owned outcome", "acceptance criteria", "template candidate"],
      "kpis": ["measured workflow completion", "accepted evidence rate"]
    },
    {
      "id": "delivery-loop",
      "name": "Delivery and release loop",
      "trigger": "Accepted bounded work",
      "outputs": ["verified local candidate", "security evidence", "rollback plan"],
      "kpis": ["first-pass verification", "escaped defect rate", "rollback readiness"]
    },
    {
      "id": "agent-capacity-loop",
      "name": "Demand-driven capacity loop",
      "trigger": "Unique queued job",
      "outputs": ["capacity decision", "signed budget grant", "bounded trace"],
      "kpis": ["idle active executions", "useful completion rate", "work units per accepted outcome"]
    },
    {
      "id": "security-loop",
      "name": "Security and incident loop",
      "trigger": "Control failure, exposure signal, or release candidate",
      "outputs": ["containment", "evidence", "owner decision", "regression check"],
      "kpis": ["unauthorized consequential actions", "open high-severity findings", "time to containment"]
    }
  ],
  "quick_links": [
    {"label": "HQ work", "route": "/work/"},
    {"label": "Agent capacity", "route": "/work/?team=engineering&view=agents"},
    {"label": "Products", "route": "/products/"},
    {"label": "Settings", "route": "/settings/"}
  ],
  "references": [
    "repository://agent_os/agent_os_architecture.md",
    "repository://mark1_pilot/agent_governance.py",
    "repository://hq/NOW.md",
    "repository://hq/WORKBOARD.md"
  ]
}
