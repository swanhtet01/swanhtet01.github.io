# SuperMega application runtime
# Copy only the values needed by the target environment. Never expose server
# secrets through VITE_* variables or commit a populated .env file.

# Local frontend proxy. Production uses the same app.supermega.dev origin.
SUPERMEGA_LOCAL_API=http://127.0.0.1:8788
SUPERMEGA_CORS_ORIGINS=https://app.supermega.dev,https://supermega.dev

# Managed trial backend. Writes remain locked until every activation gate passes.
SUPERMEGA_DATABASE_URL=
SUPERMEGA_TRIAL_IDENTITY_SECRET=
SUPERMEGA_TRIAL_WRITES_ENABLED=0

# Hosted, review-gated agent cycles. Keep activation at 0 and leave the six
# following values unset until every scheduler-authority activation gate passes.
# Production secrets belong only in protected Vercel environment variables.
# VERCEL_ENV, VERCEL_PROJECT_ID, and VERCEL_GIT_COMMIT_SHA are provider-owned
# identity inputs and must not be manually shadowed.
SUPERMEGA_HOSTED_SCHEDULER_ENABLED=0
SUPERMEGA_SCHEDULER_ACTIVATION_EVIDENCE=
SUPERMEGA_SCHEDULER_ACTIVATION_SIGNING_SECRET=
CRON_SECRET=
SUPERMEGA_INTERNAL_CRON_TOKEN=
SUPERMEGA_CLOUD_TASKS_WORKER_URL=
SUPERMEGA_CLOUD_TASKS_ALLOWED_HOSTS=
