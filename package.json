{
  "name": "supermega-platform",
  "private": true,
  "version": "0.0.0",
  "supermega": {
    "productionSupabaseProjectRef": "zvtzwcimpvvtkowflhda"
  },
  "scripts": {
    "build": "npm run public:build",
    "app:release:write": "node tools/write_app_release_metadata.mjs",
    "app:build": "npm run app:release:write && npm --prefix showroom run build && npm run app:verify",
    "app:verify": "node tools/verify_app_build.mjs && npm run app:dev:verify && node tools/verify_app_deploy_workflow.mjs && node tools/verify_app_security_contract.mjs && npm run client:prepare:self-test && npm run storage:privacy:self-test && npm run database:validator:self-test && npm run database:migrations:verify && npm run vercel:contracts:test && npm run hq:verify",
    "app:dev:verify": "node tools/verify_local_app_dev.mjs",
    "app:verify:live": "node tools/verify_app_release_live.mjs",
    "dev": "node tools/run_local_app.mjs",
    "bundle:preview": "python3 tools/package_preview_bundle.py",
    "deploy:preview": "bash tools/deploy_preview.sh",
    "vercel:pull": "npx vercel pull --yes",
    "vercel:build": "npm run public:prebuilt",
    "vercel:build:app": "npx vercel build --yes",
    "vercel:guard": "node tools/verify_public_deploy_guard.mjs",
    "database:validator:self-test": "node tools/run_python_tool.mjs tools/validate_supermega_database_url.py --self-test",
    "storage:privacy:self-test": "node tools/run_python_tool.mjs tools/verify_private_storage_privacy.py --self-test",
    "storage:privacy:preflight": "node tools/run_python_tool.mjs tools/verify_private_storage_privacy.py --preflight",
    "vercel:deploy": "node tools/deny_stale_public_deploy.mjs",
    "vercel:deploy:prod": "node tools/deny_stale_public_deploy.mjs",
    "vercel:contracts:test": "node tools/test_vercel_environment_state.mjs && node tools/test_vercel_project_state.mjs && node tools/test_vercel_domain_state.mjs",
    "public:release:guard": "node tools/verify_public_deploy_guard.mjs",
    "public:build": "node tools/create_public_vercel_output.mjs",
    "public:verify": "node tools/verify_public_vercel_artifact_budget.mjs && node tools/verify_public_vercel_output.mjs && node tools/test_public_contact_function.mjs && npm run vercel:contracts:test && npm run hq:verify",
    "public:prebuilt": "npm run public:build && npm run public:verify",
    "public:verify:live": "node tools/verify_public_release_live.mjs",
    "deploy:public:prod": "node tools/deny_stale_public_deploy.mjs",
    "kernel:verify": "npm --prefix kernel run verify",
    "deploy:kernel:prod": "npm --prefix kernel run deploy:prod",
    "db:supermega:activate": "powershell -ExecutionPolicy Bypass -File tools/activate_supermega_database.ps1",
    "database:supabase:preflight": "powershell -ExecutionPolicy Bypass -File tools/preflight_supermega_supabase.ps1",
    "database:postgres17:preflight": "node tools/run_postgres17_rehearsal.mjs --preflight",
    "database:postgres17:rehearse": "node tools/run_postgres17_rehearsal.mjs",
    "database:migrations:verify": "node tools/verify_private_trial_migrations.mjs",
    "smoke:local": "bash tools/run_local_smoke.sh",
    "smoke:public": "npm run public:prebuilt",
    "audit:lead-ledger": "node tools/audit_lead_ledger.mjs",
    "client:prepare": "node tools/prepare_client_demo.mjs",
    "client:prepare:verify": "node tools/prepare_client_demo.mjs --verify",
    "client:prepare:self-test": "node --test tools/prepare_client_demo.test.mjs",
    "audit:ally": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/audit_ally_runtime.ps1 -Json",
    "audit:ally:self-test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/audit_ally_runtime.ps1 -SelfTest -Json",
    "optimize:ally:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/trim_codex_working_sets.ps1 -Json",
    "optimize:ally": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/trim_codex_working_sets.ps1 -Apply -Json",
    "optimize:ally:self-test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/trim_codex_working_sets.ps1 -SelfTest -Json",
    "company:ally:self-test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/invoke_supermega_company_cycle.ps1 -SelfTest -Json",
    "company:ally:plan": "node kernel/scripts/plan-ally-ceo-company.mjs",
    "company:ally:plan:verify": "node kernel/scripts/plan-ally-ceo-company.mjs --verify",
    "verify:app-deploy-workflow": "node tools/verify_app_deploy_workflow.mjs",
    "hq:verify": "node tools/verify_hq_contract.mjs",
    "hq:verify:live": "node tools/verify_hq_live_state.mjs",
    "hq:verify:live:self-test": "node tools/verify_hq_live_state.mjs --self-test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4"
  }
}
