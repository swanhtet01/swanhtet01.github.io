{
  "schemaVersion": "supermega.site-context.v2",
  "contextVersion": "2026-07-30.1",
  "catalogVersion": "2026-07-30.1",
  "brand": {
    "name": "SuperMega",
    "domain": "supermega.dev",
    "version": "jade-v2-2026-07",
    "mark": "terminal",
    "colors": {
      "background": "#f6f4ee",
      "accent": "#0b745e",
      "ink": "#17231d"
    }
  },
  "company": {
    "positioning": "Operating software for Myanmar companies.",
    "statement": "Four focused SuperMega products for retail, production, websites, and ecommerce ordering.",
    "headline": "Choose the product for the work you need to run.",
    "supporting": "Shop runs orders and stock. Plant runs production and quality. Website builds company sites. Ecommerce creates Shop-connected ordering.",
    "publicPricing": false
  },
  "templatePackPolicy": {
    "contract": "supermega.product-template-pack.v1",
    "internalConfigurationOnly": true,
    "sharedCoreNoClientForks": true,
    "plannedModulesMayNotBeSoldAsAvailable": true,
    "maxEnabledModulesAtLaunch": 6,
    "lifecycle": ["choose-pack", "map-import", "preview-sample", "named-operator-pilot", "prove-outcome", "managed-activation", "measure-and-iterate"],
    "importWorkflow": ["upload", "map", "validate", "preview", "named-human-confirm", "activate"]
  },
  "customerProducts": [
    {
      "id": "shop",
      "runtimeId": "commerce",
      "kind": "operating-product",
      "name": "Shop",
      "publicAnchor": "/#shop",
      "appRoute": "https://app.supermega.dev/shop/?tab=counter",
      "status": "available-in-app",
      "eyebrow": "Shop operations",
      "headline": "Keep every order and stock movement accountable.",
      "description": "Run browser-local orders, stock, fulfilment, payment status, exceptions, and daily close across common channels. No live channel, checkout, payment, delivery, customer send, or external write is connected.",
      "primaryCta": {
        "label": "Open Shop"
      },
      "secondaryCta": {
        "label": "Configure Shop",
        "url": "/contact/?product=shop"
      },
      "modules": [
        "Sell: visual counter, cart, payment choice and accountable confirmation",
        "Orders: intake, fulfilment, payments, follow-up and close",
        "Stock: catalogue, balances, receipts and reorder exceptions",
        "Accountability: evidence, owner review and recovery"
      ],
      "internalTemplatePacks": [
        {"id": "retail", "name": "Retail", "status": "core-compatible", "firstWorkflow": "counter sale", "availableNow": ["Sell", "Orders", "Stock", "Purchasing", "Returns"], "plannedNext": ["Promotions", "Loyalty"]},
        {"id": "cafe", "name": "Cafe", "status": "core-compatible", "firstWorkflow": "counter order", "availableNow": ["Sell", "Orders", "Stock", "Daily close"], "plannedNext": ["Menu modifiers", "Kitchen tickets"]},
        {"id": "restaurant", "name": "Restaurant", "status": "core-compatible", "firstWorkflow": "take and prepare order", "availableNow": ["Sell", "Orders", "Stock", "Payments"], "plannedNext": ["Tables", "Kitchen display"]},
        {"id": "spa", "name": "Spa", "status": "core-compatible", "firstWorkflow": "sell service or product", "availableNow": ["Sell", "Orders", "Stock", "Payments"], "plannedNext": ["Appointments", "Service rooms", "Staff commission"]},
        {"id": "gym", "name": "Gym", "status": "core-compatible", "firstWorkflow": "sell membership or product", "availableNow": ["Sell", "Orders", "Stock", "Payments"], "plannedNext": ["Memberships", "Check-in", "Classes"]},
        {"id": "school", "name": "School", "status": "core-compatible", "firstWorkflow": "record fee or supply sale", "availableNow": ["Sell", "Orders", "Stock", "Payments"], "plannedNext": ["Students", "Fees", "Attendance", "Classes"]}
      ],
      "templates": [
        {
          "id": "social-commerce",
          "name": "Social commerce",
          "outcome": "Convert trusted chat channels into structured orders, stock movement, fulfilment, and follow-up.",
          "workflow": ["Capture conversation", "Confirm order", "Reserve stock", "Fulfil", "Collect payment", "Follow up"],
          "entryPoints": ["Messenger", "Viber", "Phone"],
          "metric": "Order handling time and completion rate",
          "provisioningRecipe": {
            "contract": "supermega.client_provisioning_recipe.v1",
            "recipeId": "shop.social-commerce",
            "recipeVersion": 1,
            "productId": "shop",
            "runtimeProductId": "commerce",
            "templateId": "social-commerce",
            "compatibleFromVersions": [0, 1],
            "roles": [
              {
                "id": "owner",
                "label": "Shop owner",
                "actorKind": "human",
                "capabilities": ["setup.read", "setup.write", "commerce.read", "commerce.write", "company.read", "company.write", "company.baseline.approve", "company.control.approve", "approvals.read", "approvals.request", "approvals.decide"]
              },
              {
                "id": "order-operator",
                "label": "Order operator",
                "actorKind": "human",
                "capabilities": ["commerce.read", "commerce.write", "approvals.request"]
              },
              {
                "id": "stock-keeper",
                "label": "Stock keeper",
                "actorKind": "human",
                "capabilities": ["commerce.read", "commerce.write"]
              }
            ],
            "objects": [
              {
                "id": "shop-catalog",
                "surface": "commerce",
                "keyField": "sku",
                "source": "client-import",
                "requiredCapability": "commerce.write"
              },
              {
                "id": "shop-orders",
                "surface": "commerce",
                "keyField": "id",
                "source": "runtime",
                "requiredCapability": "commerce.write"
              },
              {
                "id": "shop-evidence",
                "surface": "commerce",
                "keyField": "actionId",
                "source": "immutable-events",
                "requiredCapability": "commerce.read"
              }
            ],
            "stateMachines": [
              {
                "id": "order-fulfilment",
                "initialState": "confirmed",
                "terminalStates": ["completed", "cancelled"],
                "transitions": [
                  {"id": "start-preparation", "fromState": "confirmed", "toState": "preparing", "event": "commerce.order.advanced", "approval": "named-human"},
                  {"id": "mark-ready", "fromState": "preparing", "toState": "ready", "event": "commerce.order.advanced", "approval": "named-human"},
                  {"id": "complete-paid-order", "fromState": "ready", "toState": "completed", "event": "commerce.order.advanced", "approval": "named-human"},
                  {"id": "cancel-confirmed", "fromState": "confirmed", "toState": "cancelled", "event": "commerce.order.cancelled", "approval": "named-human"},
                  {"id": "cancel-preparing", "fromState": "preparing", "toState": "cancelled", "event": "commerce.order.cancelled", "approval": "named-human"},
                  {"id": "cancel-ready", "fromState": "ready", "toState": "cancelled", "event": "commerce.order.cancelled", "approval": "named-human"}
                ]
              }
            ],
            "importMappings": [
              {
                "id": "opening-catalog",
                "objectId": "shop-catalog",
                "workflowTemplateId": "social-commerce",
                "fields": [
                  {"target": "sku", "sourceAliases": ["sku", "item_code", "product_code"]},
                  {"target": "name", "sourceAliases": ["name", "item_name", "product_name"]},
                  {"target": "onHand", "sourceAliases": ["on_hand", "opening_stock", "quantity"]},
                  {"target": "reorderAt", "sourceAliases": ["reorder_at", "minimum_stock", "reorder_level"]},
                  {"target": "price", "sourceAliases": ["price", "price_mmk", "selling_price"]}
                ],
                "previewRequired": true,
                "humanConfirmationRequired": true
              }
            ],
            "dashboard": {
              "id": "shop-today",
              "primaryAction": "Review the earliest promised order",
              "maxVisiblePanels": 3,
              "panels": [
                {"id": "orders-next", "sourceId": "shop-orders", "label": "Orders needing the next step"},
                {"id": "stock-exceptions", "sourceId": "shop-catalog", "label": "Stock below reorder"},
                {"id": "evidence-gaps", "sourceId": "shop-evidence", "label": "Actions missing evidence"}
              ]
            },
            "acceptanceChecks": [
              {"id": "deterministic-plan", "kind": "contract", "required": true},
              {"id": "compatible-upgrade", "kind": "migration", "required": true},
              {"id": "digest-bound-rollback", "kind": "rollback", "required": true},
              {"id": "zero-unapproved-writes", "kind": "security", "required": true},
              {"id": "task-first-mobile-flow", "kind": "usability", "required": true}
            ],
            "migrations": [
              {
                "fromVersion": 0,
                "toVersion": 1,
                "steps": [
                  {"id": "introduce-social-commerce-recipe", "operation": "plan-create-resources"}
                ]
              }
            ],
            "rollback": {
              "strategy": "restore-pre-provision-snapshot",
              "requiresExactPlanDigest": true,
              "requiresHumanApproval": true,
              "steps": [
                {"id": "verify-plan-identity", "operation": "assert-plan-digest"},
                {"id": "restore-reviewed-snapshot", "operation": "plan-restore-snapshot"}
              ]
            }
          }
        },
        {
          "id": "retail-wholesale",
          "name": "Retail and wholesale",
          "outcome": "Control customer orders, stock, payment, delivery, and daily reconciliation.",
          "workflow": ["Capture order", "Allocate stock", "Pick", "Reconcile payment", "Deliver", "Close"],
          "entryPoints": ["Walk-in", "Phone", "Spreadsheet"],
          "metric": "Pick-to-close time and stock variance"
        },
        {
          "id": "restaurant-ordering",
          "name": "Restaurant ordering",
          "outcome": "Coordinate channel orders, preparation, handoff, delivery, payment, and close.",
          "workflow": ["Capture channel order", "Confirm", "Prepare", "Handoff", "Deliver", "Close"],
          "entryPoints": ["Messenger", "Phone", "Website", "Walk-in"],
          "metric": "Order-to-handoff time and exception rate"
        }
      ]
    },
    {
      "id": "plant",
      "runtimeId": "production",
      "kind": "operating-product",
      "name": "Plant",
      "publicAnchor": "/#plant",
      "appRoute": "https://app.supermega.dev/plant/?tab=production",
      "status": "available-in-app",
      "eyebrow": "Plant operations",
      "headline": "Give the plant floor one operational memory.",
      "description": "Run recurring jobs, output, machine state, quality, maintenance, exceptions, and shift handoffs in a clearly labelled local demo. Authenticated tenant writes stay locked until managed activation gates pass. No machine telemetry, machine control, access change, or external write is connected.",
      "primaryCta": {
        "label": "Open Plant"
      },
      "secondaryCta": {
        "label": "Configure Plant",
        "url": "/contact/?product=plant"
      },
      "modules": [
        "Jobs: recurring plans, targets and confirmed output",
        "Problems: quality, materials, equipment and maintenance",
        "Accountability: shift evidence, owner review and recovery"
      ],
      "internalTemplatePacks": [
        {"id": "general-manufacturing", "name": "General manufacturing", "status": "core-compatible", "firstWorkflow": "plan and record output", "availableNow": ["Jobs", "Output", "Materials", "Problems", "Quality", "Maintenance"], "plannedNext": ["Finite scheduling", "Cost rollup"]},
        {"id": "batch-process", "name": "Batch and process", "status": "core-compatible", "firstWorkflow": "run controlled batch", "availableNow": ["Jobs", "Batch control", "Materials", "Quality holds", "Output", "Shift handoff"], "plannedNext": ["Formula scaling", "Yield variance"]},
        {"id": "food-beverage", "name": "Food and beverage", "status": "core-compatible", "firstWorkflow": "make and release batch", "availableNow": ["Jobs", "Batch control", "Materials", "Quality holds", "Output", "Maintenance"], "plannedNext": ["Expiry", "Allergen controls", "Recall trace"]},
        {"id": "apparel", "name": "Apparel", "status": "core-compatible", "firstWorkflow": "run style order", "availableNow": ["Jobs", "Output", "Materials", "Problems", "Quality", "Shift handoff"], "plannedNext": ["Size-color matrix", "Cut and sew WIP"]},
        {"id": "assembly", "name": "Assembly", "status": "core-compatible", "firstWorkflow": "build and inspect order", "availableNow": ["Jobs", "Batch control", "Materials", "Quality holds", "Output", "Maintenance"], "plannedNext": ["Serial tracking", "Work instructions"]}
      ],
      "templates": [
        {
          "id": "production-control",
          "name": "Production control",
          "outcome": "Plan, run, confirm, and review output by line, shift, and product.",
          "workflow": ["Plan", "Run", "Confirm output", "Quality check", "Shift close"],
          "entryPoints": ["Shift sheet", "Spreadsheet", "ERP export"],
          "metric": "Plan attainment and confirmed good output"
        },
        {
          "id": "maintenance-downtime",
          "name": "Maintenance and downtime",
          "outcome": "Record machine state, stoppages, ownership, repair, and return to service.",
          "workflow": ["Detect", "Assign", "Repair", "Test", "Return to service"],
          "entryPoints": ["Machine log", "Supervisor handoff", "Paper form"],
          "metric": "Downtime and mean time to restore"
        },
        {
          "id": "quality-traceability",
          "name": "Quality and traceability",
          "outcome": "Capture checks, exceptions, evidence, approval, and lot history.",
          "workflow": ["Inspect", "Hold", "Investigate", "Approve", "Trace"],
          "entryPoints": ["Quality sheet", "Paper form", "ERP export"],
          "metric": "Exception closure time and trace completeness"
        }
      ]
    },
    {
      "id": "website",
      "runtimeId": "website",
      "kind": "maker-product",
      "name": "Website",
      "publicAnchor": "/#website",
      "appRoute": "https://app.supermega.dev/website/",
      "status": "available-in-app",
      "eyebrow": "Website maker",
      "headline": "Turn a short business brief into a usable website.",
      "workspaceSchema": "supermega.website.workspace.v2",
      "views": ["Start", "Edit", "Preview", "Download"],
      "workflow": ["Answer a short business brief", "Edit finite pages", "Review responsive preview", "Save ready pages", "Download standalone website", "Request managed hosting when needed"],
      "templates": [
        {
          "id": "business-presence",
          "name": "Business presence",
          "outcome": "Create a clear mobile-first company website with services, proof, and one contact path.",
          "workflow": ["Define audience", "Shape offer", "Add proof", "Review mobile", "Download website"],
          "entryPoints": ["Business brief", "Existing website", "Company profile"],
          "metric": "Time to first usable website download and qualified contact starts"
        },
        {
          "id": "lead-generation",
          "name": "Lead generation",
          "outcome": "Turn one offer into a focused landing experience with attributable proof and enquiry intent.",
          "workflow": ["Choose offer", "Write promise", "Add evidence", "Review conversion path", "Download website"],
          "entryPoints": ["Campaign brief", "Sales deck", "Service list"],
          "metric": "Qualified enquiry rate and response readiness"
        },
        {
          "id": "catalog-showcase",
          "name": "Catalog showcase",
          "outcome": "Present a finite product or service collection and route approved interest into accountable follow-up.",
          "workflow": ["Structure collection", "Add product proof", "Review navigation", "Test enquiry path", "Download website"],
          "entryPoints": ["Catalog CSV", "Product sheet", "Existing brochure"],
          "metric": "Catalog completion and enquiry handoff accuracy"
        }
      ],
      "proof": ["Content revision", "Safe destination checks", "Responsive preview", "Standalone HTML export", "Confirmed browser write", "Managed approval history when connected"],
      "boundaries": ["No CMS", "No domain write", "No analytics connection", "No deployment", "No customer send", "No payment action"]
    },
    {
      "id": "ecommerce",
      "runtimeId": "ecommerce",
      "kind": "maker-product",
      "name": "Ecommerce",
      "publicAnchor": "/#ecommerce",
      "appRoute": "https://app.supermega.dev/ecommerce/",
      "status": "release-candidate-local",
      "eyebrow": "Ecommerce maker",
      "headline": "Create a Shop-backed storefront and hand customer intent to human review.",
      "views": ["Storefront", "Preview", "Request receipt", "Shop inbox", "Shop review"],
      "workflow": ["Choose products", "Write storefront copy", "Review phone and desktop", "Retain deterministic preview digest", "Create pending request receipt", "Optionally retain exact receipt in authenticated Shop inbox", "Recover or review exact request", "Choose payment review", "Open accountable Shop action gate"],
      "templates": [
        {
          "id": "social-storefront",
          "name": "Social storefront",
