          "workflow": ["Select Shop items", "Merchandise collection", "Review mobile", "Capture request", "Confirm in Shop"],
          "entryPoints": ["Shop catalog", "Social product list", "Campaign collection"],
          "metric": "Request completion and Shop confirmation time"
        },
        {
          "id": "pickup-preorder",
          "name": "Pickup and preorder",
          "outcome": "Collect product intent for pickup or preorder without creating payment or stock side effects.",
          "workflow": ["Select availability", "Set collection", "Capture intent", "Review promise", "Confirm in Shop"],
          "entryPoints": ["Shop catalog", "Preorder sheet", "Store collection"],
          "metric": "Confirmed request rate and promise accuracy"
        },
        {
          "id": "wholesale-request",
          "name": "Wholesale request",
          "outcome": "Present a controlled wholesale assortment and hand quantity requests to a named Shop reviewer.",
          "workflow": ["Choose assortment", "Add trade context", "Capture quantities", "Review buyer details", "Confirm in Shop"],
          "entryPoints": ["Shop catalog", "Wholesale list", "Buyer request sheet"],
          "metric": "Qualified wholesale requests and review cycle time"
        }
      ],
      "proof": ["Read-only Shop catalogue snapshot", "Locked price and availability projection", "Deterministic SHA-256 preview digest", "Exact retained-ledger membership", "Idempotent receipt and exact managed replay", "Revision, action-identity, and cross-tenant conflict rejection", "Bootstrap recovery", "Unchanged Shop orders and stock movements", "Human-confirmed source-locked Shop draft", "83 Shop runtime checks", "Stale, duplicate, unknown, sold-out, repriced, insufficient-stock, oversized-inbox, and tampered request rejection"],
      "boundaries": ["No duplicate stock ledger", "No isolated hosted tenant proof", "Managed inbox uses a 100-entry revisioned Shop workspace pilot envelope; a normalized indexed queue is gated on measured scale", "No Shop order or stock reservation before separate accountable confirmation", "No cart or payment initiation", "No delivery execution", "No customer send", "No publishing", "No external write"]
    }
  ],
  "sharedCapabilities": [
    {
      "id": "ai-assistance",
      "anchor": "agents",
      "name": "AI assistance",
      "compatibilityRoute": "https://app.supermega.dev/agents/",
      "status": "gated-r-and-d",
      "firstWorkflow": "Order Intake",
      "headline": "Prepare bounded work, then let the responsible person decide.",
      "workflow": ["Choose approved input", "Create structured draft", "Show provenance", "Review or edit", "Approve or discard"],
      "boundaries": ["No autonomous send", "No payment", "No publish", "No deployment", "No access change", "No production or machine write"]
    }
  ],
  "pages": [
    { "route": "/", "file": "index.html", "title": "SuperMega | Four focused business products" },
    { "route": "/contact/", "file": "contact/index.html", "title": "Contact | SuperMega" },
    { "route": "/privacy/", "file": "privacy/index.html", "title": "Privacy | SuperMega" }
  ],
  "redirects": [
    { "source": "^/solutions/?$", "destination": "/#products" },
    { "source": "^/trust/?$", "destination": "/#trust" },
    { "source": "^/shop(?:/.*)?$", "destination": "/#shop" },
    { "source": "^/plant(?:/.*)?$", "destination": "/#plant" },
    { "source": "^/templates(?:/.*)?$", "destination": "/#products" },
    { "source": "^/work(?:/.*)?$", "destination": "/#products" },
    { "source": "^/(?:products?|offers|pricing|plans|packages)/?$", "destination": "/#products" },
    { "source": "^/products/(?:commerce|retail|restaurant|store|shop)/?.*$", "destination": "/#shop" },
    { "source": "^/products/(?:production|factory|operations|erp|plant)/?.*$", "destination": "/#plant" },
    { "source": "^/products/website/?.*$", "destination": "/#website" },
    { "source": "^/products/ecommerce/?.*$", "destination": "/#ecommerce" },
    { "source": "^/(?:ai-agent-solutions|ai-agents|agents|agent-templates|workcell|machine|agentops)/?.*$", "destination": "/#products" },
    { "source": "^/(?:find-clients|company-list|receiving-control|receiving-log|founder-brief|reconcile)/?.*$", "destination": "/#products" },
    { "source": "^/(?:start|book|setup|get-started|intake)/?.*$", "destination": "/contact/" },
    { "source": "^/(?:app|login|clients)/?.*$", "destination": "https://app.supermega.dev/" },
    { "source": "^/demo/?$", "destination": "https://app.supermega.dev/" }
  ],
  "retiredPublicNames": [
    "MegaOS",
    "Arcane",
    "Capsule",
    "M-rune",
    "Find Clients",
    "Company List",
    "Receiving Control",
    "Founder Brief",
    "WorkDesk",
    "AgentOps",
    "AI Workcell",
    "Source-to-Screen"
  ],
  "release": {
    "sourceBranch": "main",
    "workflow": ".github/workflows/supermega-public-release.yml",
    "vercelProject": "supermega-public",
    "productionDomain": "https://supermega.dev",
    "releaseEndpoint": "/__release.json"
  }
}
