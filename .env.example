# SuperMega canonical environment example
# Start with .env.app.example for app.supermega.dev. The variables below are
# optional server-side channels for supermega.dev contact requests.

SUPERMEGA_LOCAL_API=http://127.0.0.1:8788
SUPERMEGA_CORS_ORIGINS=https://app.supermega.dev,https://supermega.dev

# Managed trial: fail closed by default.
SUPERMEGA_DATABASE_URL=
SUPERMEGA_TRIAL_IDENTITY_SECRET=
SUPERMEGA_TRIAL_WRITES_ENABLED=0

# Hosted agent scheduler.
CRON_SECRET=
SUPERMEGA_INTERNAL_CRON_TOKEN=
SUPERMEGA_CLOUD_TASKS_WORKER_URL=
SUPERMEGA_CLOUD_TASKS_ALLOWED_HOSTS=

# Public lead intake. Require a 32+ character idempotency secret, the published
# Vercel contact rate-limit rule, and at least one complete server-side channel.
SUPERMEGA_CONTACT_IDEMPOTENCY_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
SUPERMEGA_CONTACT_FROM_EMAIL=SuperMega <leads@supermega.dev>
SUPERMEGA_CONTACT_NOTIFY_EMAIL=swanhtet@supermega.dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPERMEGA_LEAD_WEBHOOK_URL=
SUPERMEGA_LEAD_WEBHOOK_SECRET=
